# Copy to .env when using your own PostgreSQL or Docker Compose.
# npm run setup generates a random local password instead.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
DATABASE_URL=postgresql://cometrow:CHANGE_ME@127.0.0.1:5433/cometrow
POSTGRES_USER=cometrow
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=cometrow
LOG_LEVEL=info
